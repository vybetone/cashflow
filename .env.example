# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# FINNHUB_API_KEY: Optional, for genuine forex historical OHLC candles.
# Get free key at https://finnhub.io
FINNHUB_API_KEY=MY_FINNHUB_API_KEY

# ALPHA_VANTAGE_API_KEY: Optional secondary fallback for daily forex candles (Finnhub remains primary).
# Get free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=MY_ALPHA_VANTAGE_API_KEY

# GOOGLE_SERVICES_JSON: Optional for GitHub Actions / CI builds.
# Set this GitHub Repository Secret to the full contents of your Firebase google-services.json
# (Application ID: com.aistudio.cashflow.a3k9p). For local development, simply place google-services.json
# inside the app/ directory.
GOOGLE_SERVICES_JSON=""
